{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "MiTesterE2E": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AzureSql": "",
    "QA_Oracle": "",
    "DEV_SqlServer": "",
    "kv-bpp-ktx-qa_Oracle": "",
    "kv-bpp-ktx-qa_SqlServer": ""
  },
  "Data": {
    // Modo simulación streaming en memoria si la BD de QA no está accesible
    "UseMockSqlData": true,
    "DefaultChunkSize": 50000,
    "DefaultCommandTimeoutSeconds": 300
  },
  "Orchestration": {
    // Tamaño máximo del Channel (0 = unbounded / sin límite)
    "ChannelCapacity": 100,
    // Milisegundos de delay entre cada tick de progreso simulado (10 ticks × 500ms = ~5s por ejecución)
    "SimulatedProgressDelayMs": 500
  }
}
