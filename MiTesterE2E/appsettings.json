{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "MiTesterE2E": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AzureSql": ""
  },
  "Orchestration": {
    // Tamaño máximo del Channel (0 = unbounded / sin límite)
    "ChannelCapacity": 100,
    // Milisegundos de delay entre cada tick de progreso simulado (10 ticks × 500ms = ~5s por ejecución)
    "SimulatedProgressDelayMs": 500
  }
}
